{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node"
  },
  "include": [
    "core/**/*",
    "index.ts",
    "nextjs/**/*",
  ],
  "exclude": [
    "node_modules",
    "dist",
  ]
}